# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio. NUNCA exponer al navegador ni subir al repositorio.
# Se usa solo en Server Actions (solicitudes de invitados y acceso por token).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Datos de contacto de PES (tambien editables desde /admin/configuracion)
# ---------------------------------------------------------------
# Formato internacional, solo digitos. Panama = 507
# (507) 6995-4353  ->  50769954353
NEXT_PUBLIC_WHATSAPP_NUMBER=50769954353
NEXT_PUBLIC_CONTACT_EMAIL=pes@panamarinesolutions.com
NEXT_PUBLIC_COMPANY_NAME=Panama Energy Solutions

# ---------------------------------------------------------------
# Configuración inicial de acceso (/configurar-acceso)
# ---------------------------------------------------------------
# Si defines esta clave, crear cuentas de ADMINISTRADOR desde la página
# /configurar-acceso exigirá introducirla. En producción, define un valor
# seguro (o elimina la página /configurar-acceso). En desarrollo puedes
# dejarla sin definir para crear el primer admin sin restricción.
SETUP_SECRET=
